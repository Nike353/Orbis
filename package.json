{
  "name": "orbis",
  "version": "2.1.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-static.mjs",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:unit && npm run test:python",
    "test:unit": "vitest run",
    "test:python": "uv run --locked --python 3.12 python -m unittest discover -s tests -p 'test_*.py'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && python3 tools/build_data_js.py --check",
    "desktop:dev": "npm run build && electron .",
    "desktop:backend": "uv run --locked --python 3.12 --with pyinstaller==6.22.3 python scripts/build_desktop_backend.py",
    "desktop:build": "npm run build && npm run desktop:backend && electron-builder",
    "test:desktop": "node --test desktop/tests/*.test.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-3d": "^1.27.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "main": "desktop/main.mjs",
  "description": "Orbis \u2014 a personal research universe",
  "author": "Orbis contributors",
  "homepage": "https://github.com/Nike353/Orbis",
  "build": {
    "appId": "org.orbis.research",
    "productName": "Orbis",
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      "desktop/*.mjs",
      "desktop/preload.cjs",
      "package.json",
      "!desktop/tests/**"
    ],
    "extraResources": [
      {
        "from": "build/desktop-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop",
        "to": ".",
        "filter": [
          "google-client.json"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Orbis contributors"
    },
    "artifactName": "Orbis-${version}-${os}-${arch}.${ext}"
  }
}
